# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/snmp_api
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# SNMP Defaults
SNMP_TIMEOUT=5000
SNMP_RETRIES=2
SNMP_VERSION=3

# Secrets Management
SECRETS_PROVIDER=local
# SECRETS_PROVIDER=vault
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=your-vault-token

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Observability
ENABLE_METRICS=true
METRICS_PORT=9090
# OID Policy
OID_ALLOWLIST=1.3.6.1.2.1
OID_DENYLIST=1.3.6.1.6.3.15

# Audit
AUDIT_PERSISTENCE_ENABLED=false
